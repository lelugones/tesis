{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get_incremental_data_arguments",
  "type": "object",
  "properties": {
    "table_name": {
      "type": "string",
      "enum": ["Persona", "Familia", "Tarjeta"]
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "cursor_value": {
      "type": ["integer", "string"]
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 5000
    }
  },
  "required": ["table_name", "start_date", "end_date", "cursor_value"]
}
