{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CargadorInputPayload",
  "type": "OBJECT",
  "properties": {
    "df_dimBeneficiarios": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "id_persona_oltp": { "type": "INTEGER" },
          "nombre_completo": { "type": "STRING" },
          "grupo_etario": { "type": "STRING", "enum": ["Niño", "Adulto", "Mayor"] },
          "tarjeta_activa": { "type": "BOOLEAN" },
          "ingresos_estimados": { "type": "NUMBER" }
        },
        "required": ["id_persona_oltp", "nombre_completo", "grupo_etario", "tarjeta_activa", "ingresos_estimados"]
      }
    },
    "df_dimProgramas": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "id_programa_oltp": { "type": "INTEGER" },
          "nombre_programa": { "type": "STRING" },
          "estado": { "type": "STRING" }
        },
        "required": ["id_programa_oltp", "nombre_programa", "estado"]
      }
    },
    "df_factPolíticasAlimentarias": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "id_persona_oltp": { "type": "INTEGER" },
          "id_programa_oltp": { "type": "INTEGER" },
          "id_municipio_oltp": { "type": "INTEGER" },
          "fecha_transaccion": { "type": "STRING", "format": "date-time" },
          "admPersonas": { "type": "INTEGER" },
          "efiProgramas": { "type": "NUMBER" },
          "vulneraSocial": { "type": "NUMBER", "minimum": 0.0, "maximum": 1.0 },
          "participaMunicipal": { "type": "NUMBER" },
          "usoTarjetas": { "type": "NUMBER" }
        },
        "required": [
          "id_persona_oltp",
          "id_programa_oltp",
          "id_municipio_oltp",
          "fecha_transaccion",
          "admPersonas",
          "efiProgramas",
          "vulneraSocial",
          "participaMunicipal",
          "usoTarjetas"
        ]
      }
    }
  },
  "required": ["df_dimBeneficiarios", "df_dimProgramas", "df_factPolíticasAlimentarias"]
}
